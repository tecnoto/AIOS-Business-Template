# AI Operating System — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env
# Or run: python3 setup.py (the wizard creates .env for you)

# === Required ===
ANTHROPIC_API_KEY=                  # Claude API key (from console.anthropic.com)

# === Memory System (optional — skip for local-only memory) ===
OPENAI_API_KEY=                     # For mem0 fact extraction (GPT-4.1 Nano) + embeddings
PINECONE_API_KEY=                   # For long-term vector memory storage

# === Telegram Bot (optional — skip if not using Telegram interface) ===
TELEGRAM_BOT_TOKEN=                 # From @BotFather on Telegram
TELEGRAM_ALLOWED_USERS=             # Comma-separated Telegram user IDs

# === Local LLM (optional — Ollama must be installed separately) ===
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
