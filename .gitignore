# Environment & Credentials
.env
.env.*
credentials.json
token.json
setup_config.yaml
secrets.yaml
*.pem
*.key
*.p12
*.pfx

# Databases (generated at runtime)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
data/*.log
data/capture_markers/

# Memory logs (session-specific)
memory/logs/*.md

# Dashboard output (generated)
dashboard/*.html
dashboard/*.json

# Claude Code local settings (generated by setup.py)
.claude/settings.local.json

# Launchd plist (generated by setup.py)
tools/telegram/*.plist

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Temporary work
.tmp/

# IDE
.vscode/
.idea/

# Node (if used for Claude Code plugins)
node_modules/
