# Environment & Credentials
.env
credentials.json
token.json
setup_config.yaml

# Databases (generated at runtime)
data/*.db
data/*.log
data/capture_markers/

# Memory logs (session-specific)
memory/logs/*.md

# Dashboard output (generated)
dashboard/*.html
dashboard/*.json

# Claude Code local settings (generated by setup.py)
.claude/settings.local.json

# Launchd plist (generated by setup.py)
tools/telegram/*.plist

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/

# OS
.DS_Store
Thumbs.db

# Temporary work
.tmp/

# IDE
.vscode/
.idea/
